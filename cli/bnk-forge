def cmd_project_secret_set(args) -> None:
    project_id = _resolve_project_id(args)
    if args.from_stdin:
        value = sys.stdin.read().rstrip("\n")
    elif args.value is not None:
        value = args.value
    elif args.from_file:
        with open(args.from_file) as fh:
            value = fh.read().rstrip("\n")
    else:
        print(red("✗ Provide --value, --from-stdin, or --from-file"))
        sys.exit(EXIT_ERROR)
    body = {"name": args.key, "value": value}
    status, _, resp = api_call(
        f"/api/projects/{project_id}/secrets/value",
        method="POST",
        data=body,
        insecure=args.insecure,
    )
    if status >= 400:
        print(red(f"✗ Failed to set secret: {_extract_error(resp)}"))
        sys.exit(_exit_for_status(status))
    if args.format == "json":
        _emit(args, resp)
    else:
        print(green(f"✓ Secret '{args.key}' set on project {project_id}"))


# ---------------------------------------------------------------------------
# error helpers
# ---------------------------------------------------------------------------

def _extract_error(resp) -> str:
    if isinstance(resp, dict):
        err = resp.get("error") or {}
        if isinstance(err, dict):
            return err.get("message") or err.get("code") or json.dumps(err)
        return resp.get("detail") or resp.get("message") or json.dumps(resp)
    return str(resp)


# ---------------------------------------------------------------------------
# CLI entry point
# ---------------------------------------------------------------------------

def main() -> None:
    parser = argparse.ArgumentParser(
        prog="bnk-forge",
        description="BNK-Forge CLI — deploy, operate, and monitor F5 BIG-IP Next for Kubernetes",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent("""\
            examples:
              bnk-forge login --url https://localhost --username admin --password admin
              bnk-forge status
              bnk-forge projects list
              bnk-forge projects get abc123
              bnk-forge fleet health
              bnk-forge version
        """),
    )
    parser.add_argument("--format", choices=["table", "json"], default="table",
                        help="Output format (default: table)")
    parser.add_argument("--insecure", action="store_true",
                        help="Skip TLS certificate verification")

    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    # --- login ---
    login_parser = subparsers.add_parser("login", help="Authenticate with BNK-Forge")
    login_parser.add_argument("--url", required=True, help="BNK-Forge server URL (e.g. https://localhost)")
    login_parser.add_argument("--username", required=True, help="Username")
    login_parser.add_argument("--password", required=True, help="Password")

    # --- status ---
    subparsers.add_parser("status", help="Show system health status")

    # --- version ---
    subparsers.add_parser("version", help="Show CLI and server version")

    # --- projects ---
    projects_parser = subparsers.add_parser("projects", help="Manage projects")
    projects_sub = projects_parser.add_subparsers(dest="projects_command")

    projects_sub.add_parser("list", help="List all projects")

    get_parser = projects_sub.add_parser("get", help="Get project details")
    get_parser.add_argument("id", help="Project ID")

    # --- fleet ---
    fleet_parser = subparsers.add_parser("fleet", help="Fleet management")
    fleet_sub = fleet_parser.add_subparsers(dest="fleet_command")
    fleet_sub.add_parser("health", help="Show fleet health")

    # --- auth (token sub-commands) ---
    auth_parser = subparsers.add_parser("auth", help="Authentication and API tokens")
    auth_sub = auth_parser.add_subparsers(dest="auth_command")

    token_parser = auth_sub.add_parser("token", help="Manage API tokens")
    token_sub = token_parser.add_subparsers(dest="token_command")

    tc_create = token_sub.add_parser("create", help="Issue a new API token (plaintext shown once)")
    tc_create.add_argument("--name", required=True, help="Human-readable name (e.g. 'ci-pipeline')")
    tc_create.add_argument("--role", choices=["viewer", "operator", "admin"], help="Token role (defaults to caller's role)")
    tc_create.add_argument("--expires-days", type=int, dest="expires_days", help="Lifetime in days (1-3650; default: never expires)")

    token_sub.add_parser("list", help="List your API tokens (plaintext is never shown)")

    tc_delete = token_sub.add_parser("delete", help="Revoke an API token by ID")
    tc_delete.add_argument("id", type=int, help="Token ID")

    # --- project (deploy / plan / destroy / show / secret) ---
    project_parser = subparsers.add_parser("project", help="Operate on a single project (CI-friendly)")
    project_sub = project_parser.add_subparsers(dest="project_command")

    pp_show = project_sub.add_parser("show", help="Show project + module state")
    pp_show.add_argument("project", help="Project ID or exact project name")

    pp_deploy = project_sub.add_parser("deploy", help="Deploy a module (or whole project)")
    pp_deploy.add_argument("project", help="Project ID or exact project name")
    pp_deploy.add_argument("--module", help="Module ID or path-in-project; omit to deploy entire project")
    pp_deploy.add_argument("--wait", action="store_true", help="Block until the task completes")
    pp_deploy.add_argument("--timeout", default="30m", help="Wait timeout (e.g. 30m, 2h, 600s) — default 30m")

    pp_plan = project_sub.add_parser("plan", help="Plan a module (exit 2 if changes pending)")
    pp_plan.add_argument("project", help="Project ID or exact project name")
    pp_plan.add_argument("--module", required=True, help="Module ID or path-in-project")
    pp_plan.add_argument("--timeout", default="30m", help="Wait timeout (default 30m)")

    pp_destroy = project_sub.add_parser("destroy", help="Destroy a module (or whole project)")
    pp_destroy.add_argument("project", help="Project ID or exact project name")
    pp_destroy.add_argument("--module", help="Module ID or path-in-project")
    pp_destroy.add_argument("--yes", action="store_true", help="Required confirmation flag")
    pp_destroy.add_argument("--wait", action="store_true", help="Block until task completes")
    pp_destroy.add_argument("--timeout", default="30m", help="Wait timeout (default 30m)")

    pp_secret = project_sub.add_parser("secret", help="Manage project secrets")
    pp_secret_sub = pp_secret.add_subparsers(dest="secret_command")
    ps_set = pp_secret_sub.add_parser("set", help="Set a project secret value")
    ps_set.add_argument("project", help="Project ID or exact project name")
    ps_set.add_argument("key", help="Secret key (variable name)")
    ps_set.add_argument("--value", help="Inline value (visible in shell history — prefer --from-stdin)")
    ps_set.add_argument("--from-stdin", action="store_true", dest="from_stdin", help="Read value from stdin")
    ps_set.add_argument("--from-file", dest="from_file", help="Read value from a file path")

    # --- task status ---
    task_parser = subparsers.add_parser("task", help="Inspect Celery / orchestrator tasks")
    task_sub = task_parser.add_subparsers(dest="task_command")
    ts = task_sub.add_parser("status", help="Show task status (use --wait to poll until terminal)")
    ts.add_argument("id", help="Task ID (UUID)")
    ts.add_argument("--wait", action="store_true", help="Poll until terminal")
    ts.add_argument("--timeout", default="30m", help="Wait timeout (default 30m)")

    # Parse
    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(0)

    # Dispatch
    if args.command == "login":
        cmd_login(args)
    elif args.command == "status":
        cmd_status(args)
    elif args.command == "version":
        cmd_version(args)
    elif args.command == "projects":
        if not args.projects_command:
            print(red("✗ Specify a subcommand: list, get"))
            sys.exit(1)
        if args.projects_command == "list":
            cmd_projects_list(args)
        elif args.projects_command == "get":
            cmd_projects_get(args)
    elif args.command == "fleet":
        if not args.fleet_command:
            print(red("✗ Specify a subcommand: health"))
            sys.exit(1)
        if args.fleet_command == "health":
            cmd_fleet_health(args)
    elif args.command == "auth":
        if args.auth_command == "token":
            if args.token_command == "create":
                cmd_auth_token_create(args)
            elif args.token_command == "list":
                cmd_auth_token_list(args)
            elif args.token_command == "delete":
                cmd_auth_token_delete(args)
            else:
                print(red("✗ Specify a token subcommand: create, list, delete"))
                sys.exit(EXIT_ERROR)
        else:
            print(red("✗ Specify an auth subcommand: token"))
            sys.exit(EXIT_ERROR)
    elif args.command == "project":
        if args.project_command == "show":
            cmd_project_show(args)
        elif args.project_command == "deploy":
            cmd_project_deploy(args)
        elif args.project_command == "plan":
            cmd_project_plan(args)
        elif args.project_command == "destroy":
            cmd_project_destroy(args)
        elif args.project_command == "secret":
            if args.secret_command == "set":
                cmd_project_secret_set(args)
            else:
                print(red("✗ Specify a secret subcommand: set"))
                sys.exit(EXIT_ERROR)
        else:
            print(red("✗ Specify a project subcommand: show, deploy, plan, destroy, secret"))
            sys.exit(EXIT_ERROR)
    elif args.command == "task":
        if args.task_command == "status":
            cmd_task_status(args)
        else:
            print(red("✗ Specify a task subcommand: status"))
            sys.exit(EXIT_ERROR)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
