def cmd_auth_token_create(args) -> None:
    body = {"name": args.name}
    if args.role:
        body["role"] = args.role
    if args.expires_days:
        body["expires_in_days"] = int(args.expires_days)
    status, _, resp = api_call("/api/auth/tokens", method="POST", data=body, insecure=args.insecure)
    if status >= 400:
        msg = _extract_error(resp)
        print(red(f"✗ Failed to create token: {msg}"))
        sys.exit(_exit_for_status(status))
    if args.format == "json":
        _emit(args, resp)
        return
    print(green(f"✓ Token created: {resp.get('name')}  (id={resp.get('id')}, role={resp.get('role')})"))
    print(yellow("   Save this token now — it will not be shown again:"))
    print(f"   {resp.get('token')}")
    if resp.get("expires_at"):
        print(dim(f"   Expires: {resp['expires_at']}"))


def cmd_auth_token_list(args) -> None:
    status, _, resp = api_call("/api/auth/tokens", insecure=args.insecure)
    if status >= 400:
        print(red(f"✗ Failed to list tokens: {_extract_error(resp)}"))
        sys.exit(_exit_for_status(status))
    tokens = resp.get("tokens", []) if isinstance(resp, dict) else []
    if args.format == "json":
        _emit(args, {"tokens": tokens})
        return
    if not tokens:
        print(dim("(no tokens)"))
        return
    rows = [
        [str(t.get("id", "")), t.get("name", ""), t.get("role", ""),
         t.get("token_prefix", ""), t.get("expires_at") or "-",
         t.get("last_used_at") or "-"]
        for t in tokens
    ]
    print_table(["ID", "Name", "Role", "Prefix", "Expires", "Last used"], rows)


def cmd_auth_token_delete(args) -> None:
    status, _, resp = api_call(f"/api/auth/tokens/{args.id}", method="DELETE", insecure=args.insecure)
    if status >= 400:
        print(red(f"✗ Failed to revoke token: {_extract_error(resp)}"))
        sys.exit(_exit_for_status(status))
    print(green(f"✓ Token {args.id} revoked"))


