def cmd_login(args) -> None:
    """Authenticate and save token."""
    url = args.url.rstrip("/")
    login_url = f"{url}/api/auth/login"

    status, headers, body = _make_request(
        login_url,
        method="POST",
        data={"username": args.username, "password": args.password},
        insecure=args.insecure,
    )

    if status == 200 and isinstance(body, dict) and "token" in body:
        cfg = {
            "url": url,
            "token": body["token"],
            "username": args.username,
            "logged_in_at": datetime.now().isoformat(),
        }
        if body.get("user"):
            cfg["role"] = body["user"].get("role", "unknown")
        save_config(cfg)
        user_info = body.get("user", {})
        role = user_info.get("role", "unknown")
        print(green(f"✓ Logged in as {bold(args.username)} (role: {role})"))
        print(dim(f"  Token saved to {CONFIG_FILE}"))

        if body.get("must_change_password"):
            print(yellow("⚠ You must change your password. Use the web UI."))
    elif status == 0:
        print(red(f"✗ Cannot connect to {url}"))
        print(dim(f"  {body}"))
        sys.exit(1)
    else:
        detail = body.get("detail", body) if isinstance(body, dict) else body
        print(red(f"✗ Login failed (HTTP {status}): {detail}"))
        sys.exit(1)


def cmd_status(args) -> None:
    """Show system health status."""
    status, headers, body = api_call("/api/system/health", insecure=args.insecure)

    if args.format == "json":
        print(json.dumps(body, indent=2))
        return

    if status != 200:
        print(red(f"✗ Health check failed (HTTP {status})"))
        sys.exit(1)

    # Read version from response header
    server_version = headers.get("X-BNK-Forge-Version", headers.get("x-bnk-forge-version", ""))

    print(bold("BNK-Forge System Status"))
    print()

    # Derive overall status from services (if no top-level status field)
    overall = body.get("status", "")
    if not overall:
        services = body.get("services", {})
        if services:
            statuses = []
            for svc_info in services.values():
                if isinstance(svc_info, dict):
                    statuses.append(svc_info.get("status", "unknown"))
            if all(s in ("healthy", "connected", "ok") for s in statuses):
                overall = "healthy"
            elif any(s in ("unhealthy", "error", "down") for s in statuses):
                overall = "unhealthy"
            else:
                overall = "degraded"
        else:
            overall = "unknown"
    color_fn = green if overall == "healthy" else (yellow if overall == "degraded" else red)
    print(f"  Status:  {color_fn(bold(overall.upper()))}")
    if server_version:
        print(f"  Version: {server_version}")
    print()

    # Services
    services = body.get("services", {})
    if services:
        print(bold("  Services:"))
        for svc_name, svc_info in services.items():
            if isinstance(svc_info, dict):
                svc_status = svc_info.get("status", "unknown")
            else:
                svc_status = str(svc_info)
            icon = green("●") if svc_status in ("healthy", "connected", "ok") else red("●")
            print(f"    {icon} {svc_name}: {svc_status}")
        print()

    # Counts
    counts = body.get("counts", {})
    if counts:
        print(bold("  Resources:"))
        for key, val in counts.items():
            print(f"    {key}: {val}")


def cmd_projects_list(args) -> None:
    """List all projects."""
    status, headers, body = api_call("/api/projects", insecure=args.insecure)

    if args.format == "json":
        print(json.dumps(body, indent=2))
        return

    if status != 200:
        detail = body.get("detail", body) if isinstance(body, dict) else body
        print(red(f"✗ Failed to list projects (HTTP {status}): {detail}"))
        sys.exit(1)

    # body could be a list or dict with a "projects" key
    projects = body if isinstance(body, list) else body.get("projects", [])

    print(bold(f"Projects ({len(projects)})"))
    print()

    rows = []
    for p in projects:
        pid = str(p.get("id", ""))[:8]
        name = p.get("name", "unnamed")
        status_val = p.get("status", "")
        engine = p.get("execution_engine", p.get("engine", ""))
        module_count = str(p.get("module_count", ""))
        rows.append([pid, name, status_val, engine, module_count])

    print_table(["ID", "NAME", "STATUS", "ENGINE", "MODULES"], rows)


def cmd_projects_get(args) -> None:
    """Get project details."""
    status, headers, body = api_call(f"/api/projects/{args.id}", insecure=args.insecure)

    if args.format == "json":
        print(json.dumps(body, indent=2))
        return

    if status == 404:
        print(red(f"✗ Project not found: {args.id}"))
        sys.exit(1)
    if status != 200:
        detail = body.get("detail", body) if isinstance(body, dict) else body
        print(red(f"✗ Failed to get project (HTTP {status}): {detail}"))
        sys.exit(1)

    p = body if isinstance(body, dict) else {}
    print(bold(f"Project: {p.get('name', 'unknown')}"))
    print()
    print(f"  ID:          {p.get('id', '')}")
    print(f"  Status:      {p.get('status', '')}")
    print(f"  Engine:      {p.get('execution_engine', p.get('engine', ''))}")
    print(f"  Description: {p.get('description', '')}")
    print(f"  Created:     {p.get('created_at', '')}")
    print(f"  Updated:     {p.get('updated_at', '')}")

    # Modules. The project detail response carries summary counts, not the module
    # list (its response_model strips anything it doesn't declare), so they have
    # to be fetched from the project-modules route — reading p["modules"] here
    # printed nothing, always.
    modules = _list_project_modules(int(p.get("id") or args.id), args.insecure)
    if modules:
        print()
        print(bold(f"  Modules ({len(modules)}):"))
        for m in modules:
            mname = m.get("module_name") or m.get("path_in_project") or "unnamed"
            mstatus = m.get("status", "")
            print(f"    • {mname} ({mstatus})")


def cmd_fleet_health(args) -> None:
    """Show fleet health for all operators."""
    status, headers, body = api_call("/api/operators/fleet-health", insecure=args.insecure)

    if args.format == "json":
        print(json.dumps(body, indent=2))
        return

    if status != 200:
        detail = body.get("detail", body) if isinstance(body, dict) else body
        print(red(f"✗ Failed to get fleet health (HTTP {status}): {detail}"))
        sys.exit(1)

    print(bold("Fleet Health"))
    print()

    # Summary
    summary = body.get("summary", {})
    if summary:
        total = summary.get("total_operators", 0)
        online = summary.get("online", 0)
        offline = summary.get("offline", 0)
        print(f"  Operators: {bold(str(total))} total, {green(str(online))} online, {red(str(offline))} offline")
        print()

    # Per-operator table
    operators = body.get("operators", [])
    if operators:
        rows = []
        for op in operators:
            name = op.get("name", op.get("hostname", "unknown"))
            op_status = op.get("status", "unknown")
            cluster = op.get("cluster_name", op.get("cluster", ""))
            version = op.get("version", "")
            last_seen = op.get("last_seen", op.get("last_heartbeat", ""))
            if last_seen and len(last_seen) > 19:
                last_seen = last_seen[:19]  # Trim to readable length
            rows.append([name, op_status, cluster, version, last_seen])
        print_table(["OPERATOR", "STATUS", "CLUSTER", "VERSION", "LAST SEEN"], rows)
    elif not summary:
        print(dim("  No operators registered."))


def cmd_version(args) -> None:
    """Print CLI version and server version."""
    print(f"  CLI version:    {bold(CLI_VERSION)}")

    cfg = load_config()
    base_url = cfg.get("url")
    if not base_url:
        print(dim("  Server version: (not logged in)"))
        return

    # Hit a lightweight endpoint to read version header
    url = f"{base_url.rstrip('/')}/api/system/health"
    status, headers, body = _make_request(url, token=cfg.get("token"), insecure=args.insecure)

    if status == 200:
        server_version = headers.get("X-BNK-Forge-Version", headers.get("x-bnk-forge-version", "unknown"))
        api_version = headers.get("X-BNK-Forge-API", headers.get("x-bnk-forge-api", "unknown"))
        server_url = cfg.get("url", "unknown")
        print(f"  Server version: {bold(server_version)}")
        print(f"  API version:    {bold(api_version)}")
        print(f"  Server URL:     {dim(server_url)}")
    else:
        print(red(f"  Server version: (unreachable — HTTP {status})"))


