#!/usr/bin/env python3
"""
BNK-Forge CLI — command-line interface for the BNK-Forge API.

Stdlib only (argparse, urllib, json). Works with Python 3.9+.
No pip dependencies required.

Usage:
  bnk-forge login --url https://forge.example.com --username admin --password <pass>
  bnk-forge status
  bnk-forge projects list
  bnk-forge projects get <id>
  bnk-forge fleet health
  bnk-forge version
"""

from __future__ import annotations

import argparse
import json
import os
import ssl
import sys
import textwrap
import urllib.error
import urllib.request
from datetime import datetime
from pathlib import Path
from typing import Dict, List, Optional, Tuple

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

CLI_VERSION = "0.1.0"
CONFIG_DIR = Path.home() / ".bnk-forge"
CONFIG_FILE = CONFIG_DIR / "config.json"

# ---------------------------------------------------------------------------
# Color helpers (graceful fallback)
# ---------------------------------------------------------------------------

def _supports_color() -> bool:
    """Check if the terminal supports ANSI color."""
    if os.getenv("NO_COLOR"):
        return False
    if os.getenv("FORCE_COLOR"):
        return True
    if not hasattr(sys.stdout, "isatty") or not sys.stdout.isatty():
        return False
    return True

_COLOR = _supports_color()

def _c(code: str, text: str) -> str:
    if not _COLOR:
        return text
    return f"\033[{code}m{text}\033[0m"

def green(t: str) -> str:   return _c("32", t)
def red(t: str) -> str:     return _c("31", t)
def yellow(t: str) -> str:  return _c("33", t)
def cyan(t: str) -> str:    return _c("36", t)
def bold(t: str) -> str:    return _c("1", t)
def dim(t: str) -> str:     return _c("2", t)

# ---------------------------------------------------------------------------
# Config persistence (~/.bnk-forge/config.json)
# ---------------------------------------------------------------------------

def load_config() -> dict:
    if CONFIG_FILE.exists():
        with open(CONFIG_FILE) as f:
            return json.load(f)
    return {}

def save_config(cfg: dict) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        json.dump(cfg, f, indent=2)
    # Restrict permissions (token inside)
    os.chmod(CONFIG_FILE, 0o600)

# ---------------------------------------------------------------------------
# HTTP client (stdlib only)
# ---------------------------------------------------------------------------

def _make_request(
    url: str,
    method: str = "GET",
    data: dict | None = None,
    token: str | None = None,
    insecure: bool = False,
) -> tuple:
    """
    Make an HTTP request. Returns (status_code, headers, body_dict_or_str).
    """
    headers = {"Accept": "application/json"}
    if token:
        headers["Authorization"] = f"Bearer {token}"

    body_bytes = None
    if data is not None:
        body_bytes = json.dumps(data).encode("utf-8")
        headers["Content-Type"] = "application/json"

    req = urllib.request.Request(url, data=body_bytes, headers=headers, method=method)

    ctx = None
    if insecure:
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE

    try:
        resp = urllib.request.urlopen(req, context=ctx, timeout=30)
        resp_body = resp.read().decode("utf-8")
        try:
            resp_json = json.loads(resp_body)
        except json.JSONDecodeError:
            resp_json = resp_body
        return resp.status, dict(resp.headers), resp_json
    except urllib.error.HTTPError as e:
        resp_body = e.read().decode("utf-8") if e.fp else ""
        try:
            resp_json = json.loads(resp_body)
        except (json.JSONDecodeError, ValueError):
            resp_json = resp_body
        return e.code, dict(e.headers) if hasattr(e, "headers") else {}, resp_json
    except urllib.error.URLError as e:
        return 0, {}, str(e.reason)

def api_call(path: str, method: str = "GET", data: dict | None = None, insecure: bool = False) -> tuple:
    """Make an authenticated API call.

    Resolution order: env vars first, then ~/.bnk-forge/config.json. This makes
    the CLI usable in CI/CD without ever writing a config file:

        BNK_FORGE_URL=https://forge.example.com
        BNK_FORGE_TOKEN=bnk_<token>

    Returns (status_code, headers, body).
    """
    cfg = load_config()
    base_url = os.environ.get("BNK_FORGE_URL") or cfg.get("url")
    token = os.environ.get("BNK_FORGE_TOKEN") or cfg.get("token")
    if os.environ.get("BNK_FORGE_INSECURE", "").lower() in ("1", "true", "yes"):
        insecure = True

    if not base_url:
        print(red("✗ No server URL set. Use BNK_FORGE_URL or `bnk-forge login`."))
        sys.exit(EXIT_AUTH)
    if not token:
        print(red("✗ No auth token set. Use BNK_FORGE_TOKEN or `bnk-forge login`."))
        sys.exit(EXIT_AUTH)

    url = f"{base_url.rstrip('/')}{path}"
    status, headers, body = _make_request(url, method=method, data=data, token=token, insecure=insecure)
    _abort_if_unreachable(status, base_url, body)
    return status, headers, body


def _abort_if_unreachable(status: int, base_url: str, body) -> None:
    """Exit non-zero when the server could not be reached at all.

    _make_request reports a transport failure (DNS, refused, TLS, timeout) as
    status 0. Every caller guards with `status >= 400`, so without this an
    unreachable Forge would sail through as success — the worst possible
    outcome in a CI pipeline.
    """
    if status == 0:
        print(red(f"✗ Cannot reach BNK Forge at {base_url}: {body}"))
        sys.exit(EXIT_ERROR)


# ---------------------------------------------------------------------------
# Exit codes (documented; callers should use these constants)
# ---------------------------------------------------------------------------

EXIT_OK = 0
EXIT_ERROR = 1
EXIT_PLAN_HAS_CHANGES = 2  # `plan` exit code when changes pending (Terraform-style)
EXIT_AUTH = 3              # 401/403 or missing config
EXIT_NOT_FOUND = 4         # 404
EXIT_TIMEOUT = 5           # --wait timed out

def _exit_for_status(status: int) -> int:
    if status == 401 or status == 403:
        return EXIT_AUTH
    if status == 404:
        return EXIT_NOT_FOUND
    return EXIT_ERROR


def _emit(args, payload, *, table_headers=None, table_rows=None, text_lines=None) -> None:
    """Render `payload` according to args.format.

    - json: dump payload as JSON
    - table: render the provided headers/rows (fall back to JSON if not given)
    - text (or default): print text_lines if given, else fall back to JSON
    """
    fmt = getattr(args, "format", "table")
    if fmt == "json":
        print(json.dumps(payload, default=str, indent=2))
        return
    if fmt == "table" and table_headers is not None and table_rows is not None:
        print_table(table_headers, table_rows)
        return
    if text_lines is not None:
        for line in text_lines:
            print(line)
        return
    print(json.dumps(payload, default=str, indent=2))

# ---------------------------------------------------------------------------
# Table formatter
# ---------------------------------------------------------------------------

def print_table(headers: list[str], rows: list[list[str]]) -> None:
    """Print a simple ASCII table."""
    if not rows:
        print(dim("  (no data)"))
        return

    # Calculate column widths
    widths = [len(h) for h in headers]
    for row in rows:
        for i, cell in enumerate(row):
            if i < len(widths):
                widths[i] = max(widths[i], len(str(cell)))

    # Header
    header_line = "  ".join(bold(h.ljust(w)) for h, w in zip(headers, widths))
    sep_line = "  ".join("─" * w for w in widths)
    print(header_line)
    print(dim(sep_line))

    # Rows
    for row in rows:
        cells = []
        for i, cell in enumerate(row):
            w = widths[i] if i < len(widths) else 0
            cells.append(str(cell).ljust(w))
        print("  ".join(cells))

