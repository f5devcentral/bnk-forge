def _resolve_project_id(args) -> int:
    """Accept either a numeric id or an exact project name.

    Projects have no slug — the API keys them by id, and GET /api/projects is
    the only listing. Names are not unique, so an ambiguous name is an error
    rather than a coin flip.
    """
    raw = args.project
    if raw.isdigit():
        return int(raw)
    status, _, resp = api_call("/api/projects", insecure=args.insecure)
    if status >= 400:
        print(red(f"✗ Failed to resolve project '{raw}': {_extract_error(resp)}"))
        sys.exit(_exit_for_status(status))
    projects = resp.get("projects", []) if isinstance(resp, dict) else []
    matches = [p for p in projects if p.get("name") == raw]
    if not matches:
        print(red(f"✗ Project '{raw}' not found"))
        sys.exit(EXIT_NOT_FOUND)
    if len(matches) > 1:
        print(red(f"✗ Project name '{raw}' is ambiguous ({len(matches)} matches) — use the numeric ID"))
        sys.exit(EXIT_ERROR)
    return int(matches[0]["id"])


def _list_project_modules(project_id: int, insecure: bool) -> list:
    """The project's modules. Lives under /api/project-modules, not /api/projects."""
    status, _, resp = api_call(f"/api/project-modules/project/{project_id}", insecure=insecure)
    if status >= 400:
        print(red(f"✗ Failed to list project modules: {_extract_error(resp)}"))
        sys.exit(_exit_for_status(status))
    return resp.get("modules", []) if isinstance(resp, dict) else []


def _resolve_module_id(project_id: int, module_arg: str, insecure: bool) -> int:
    """Accept either a numeric id or a path_in_project."""
    if module_arg.isdigit():
        return int(module_arg)
    modules = _list_project_modules(project_id, insecure)
    matches = [m for m in modules if m.get("path_in_project") == module_arg]
    if not matches:
        print(red(f"✗ Module '{module_arg}' not found in project {project_id}"))
        sys.exit(EXIT_NOT_FOUND)
    return int(matches[0]["id"])


def cmd_project_show(args) -> None:
    project_id = _resolve_project_id(args)
    status, _, resp = api_call(f"/api/projects/{project_id}", insecure=args.insecure)
    if status >= 400:
        print(red(f"✗ Failed to get project: {_extract_error(resp)}"))
        sys.exit(_exit_for_status(status))
    # The project response carries summary counts, not the modules themselves —
    # they come from the project-modules listing.
    modules = _list_project_modules(project_id, args.insecure)
    if args.format == "json":
        _emit(args, {**resp, "modules": modules})
        return
    print(bold(f"Project: {resp.get('name')} (id={resp.get('id')})"))
    print(dim(f"  cloud_provider: {resp.get('cloud_provider')}  region: {resp.get('region')}"))
    print(dim(f"  modules: {resp.get('module_count', 0)}  deployed: {resp.get('deployed_count', 0)}"
              f"  failed: {resp.get('failed_count', 0)}"))
    if modules:
        rows = [
            [str(m.get("id", "")), m.get("path_in_project", ""),
             m.get("status", "-"), m.get("module_name") or ""]
            for m in modules
        ]
        print_table(["ID", "Path", "Status", "Module"], rows)
    else:
        print(dim("  (no modules attached)"))


def _run_started(args, project_id: int, resp, verb: str) -> None:
    """Report a started run and, with --wait, block until it is terminal.

    A module-level run returns an int ``task_id`` pollable at /api/tasks/{id}.
    A whole-project run is orchestrated: it returns ``orchestrator_task_id`` (a
    run handle), which is NOT an int task id and is pollable only at
    /api/projects/{id}/orchestration/{handle}. Reading `task_id` for both is why
    `--wait` used to be a silent no-op on whole-project runs — it exited 0
    immediately, reporting success for a deploy that had barely started.
    """
    body = resp if isinstance(resp, dict) else {}
    task_id = body.get("task_id")
    run_handle = body.get("orchestrator_task_id")

    if args.format == "json":
        _emit(args, resp)
    else:
        handle = task_id or run_handle
        print(green(f"✓ {verb} started" + (f" ({handle})" if handle else "")))

    if not args.wait:
        return

    if task_id:
        sys.exit(_wait_for_task(task_id, timeout=args.timeout, insecure=args.insecure, fmt=args.format))
    if run_handle:
        sys.exit(_wait_for_run(project_id, run_handle, timeout=args.timeout,
                               insecure=args.insecure, fmt=args.format))
    # --wait was asked for and we have nothing to wait on: that is an error, not
    # a success. Never exit 0 on a run whose outcome we cannot observe.
    print(red(f"✗ {verb} started but returned no task id or run handle — cannot --wait"))
    sys.exit(EXIT_ERROR)


def _wait_for_run(project_id: int, run_handle: str, *, timeout, insecure: bool, fmt: str) -> int:
    """Poll a whole-project orchestration run until terminal. Returns the exit code."""
    import time

    deadline = time.time() + _parse_timeout(timeout)
    last_state = None
    while True:
        status, _, resp = api_call(
            f"/api/projects/{project_id}/orchestration/{run_handle}", insecure=insecure
        )
        if status >= 400:
            print(red(f"✗ Run lookup failed: {_extract_error(resp)}"))
            return _exit_for_status(status)
        body = resp if isinstance(resp, dict) else {}
        state = (body.get("status") or "").lower()

        if state != last_state and fmt != "json":
            pct = body.get("progress_percent")
            layer = f"layer {body.get('current_layer')}/{body.get('total_layers')}"
            print(dim(f"  run {run_handle}: {state} ({layer}"
                      + (f", {pct:.0f}%" if isinstance(pct, (int, float)) else "") + ")"))
        last_state = state

        if state == "completed":
            if fmt == "json":
                print(json.dumps(body, default=str, indent=2))
            else:
                print(green(f"✓ run {run_handle}: completed"))
            return EXIT_OK
        if state == "failed":
            if fmt == "json":
                print(json.dumps(body, default=str, indent=2))
            else:
                failed = body.get("failed_modules") or []
                err = body.get("error_message") or ""
                print(red(f"✗ run {run_handle}: failed"
                          + (f" (modules {failed})" if failed else "")
                          + (f" — {err}" if err else "")))
            return EXIT_ERROR
        if time.time() > deadline:
            print(red(f"✗ run {run_handle}: timed out waiting for completion"))
            return EXIT_TIMEOUT
        time.sleep(3)


def cmd_project_deploy(args) -> None:
    project_id = _resolve_project_id(args)
    if args.module:
        module_id = _resolve_module_id(project_id, args.module, args.insecure)
        path = f"/api/project-modules/{module_id}/deploy"
    else:
        path = f"/api/projects/{project_id}/deploy-all"
    status, _, resp = api_call(path, method="POST", insecure=args.insecure)
    if status >= 400:
        print(red(f"✗ Deploy failed: {_extract_error(resp)}"))
        sys.exit(_exit_for_status(status))
    _run_started(args, project_id, resp, "Deploy")


def cmd_project_plan(args) -> None:
    project_id = _resolve_project_id(args)
    if not args.module:
        print(red("✗ --module is required for plan (whole-project plan is not yet supported)"))
        sys.exit(EXIT_ERROR)
    module_id = _resolve_module_id(project_id, args.module, args.insecure)
    status, _, resp = api_call(f"/api/project-modules/{module_id}/plan", method="POST", insecure=args.insecure)
    if status >= 400:
        print(red(f"✗ Plan failed: {_extract_error(resp)}"))
        sys.exit(_exit_for_status(status))
    task_id = (resp or {}).get("task_id") if isinstance(resp, dict) else None
    if not task_id:
        print(red("✗ Plan response had no task_id"))
        sys.exit(EXIT_ERROR)
    # Plan is async: wait for completion, then read the resource delta the plan
    # recorded. `has_changes` is None when the module has never been planned —
    # that is an error, not "no changes" (exiting 0 there would let a pipeline
    # gate on a plan that never produced a result).
    rc = _wait_for_task(task_id, timeout=args.timeout, insecure=args.insecure, fmt=args.format)
    if rc != EXIT_OK:
        sys.exit(rc)
    s2, _, mod_resp = api_call(f"/api/project-modules/{module_id}/plan-status", insecure=args.insecure)
    if s2 >= 400 or not isinstance(mod_resp, dict):
        print(red(f"✗ Could not read plan status: {_extract_error(mod_resp)}"))
        sys.exit(_exit_for_status(s2))

    has_changes = mod_resp.get("has_changes")
    if has_changes is None:
        print(red("✗ Plan completed but recorded no result — cannot determine changes"))
        sys.exit(EXIT_ERROR)

    if args.format == "json":
        _emit(args, mod_resp)
    else:
        changes = mod_resp.get("resource_changes") or {}
        if has_changes:
            print(yellow(
                f"⚠ Changes pending: {changes.get('add', 0)} to add, "
                f"{changes.get('change', 0)} to change, {changes.get('destroy', 0)} to destroy"
            ))
        else:
            print(green("✓ No changes"))
    sys.exit(EXIT_PLAN_HAS_CHANGES if has_changes else EXIT_OK)


def cmd_project_destroy(args) -> None:
    if not args.yes:
        print(red("✗ Refusing to destroy without --yes"))
        sys.exit(EXIT_ERROR)
    project_id = _resolve_project_id(args)
    body: dict | None = None
    if args.module:
        module_id = _resolve_module_id(project_id, args.module, args.insecure)
        path = f"/api/project-modules/{module_id}/destroy"
        # This route takes a required OpenTofuActionRequest body — omitting it is a 422.
        body = {"auto_approve": True}
    else:
        # Whole-project destroy — use orchestration endpoint.
        path = f"/api/projects/{project_id}/destroy-all"
    status, _, resp = api_call(path, method="POST", data=body, insecure=args.insecure)
    if status >= 400:
        print(red(f"✗ Destroy failed: {_extract_error(resp)}"))
        sys.exit(_exit_for_status(status))
    _run_started(args, project_id, resp, "Destroy")


# ---------------------------------------------------------------------------
# task status
# ---------------------------------------------------------------------------

def _parse_timeout(spec: str | None) -> int:
    """Parse '30m', '1h', '90s' or bare integer seconds. Defaults to 1800s."""
    if not spec:
        return 1800
    s = spec.strip().lower()
    if s.endswith("s"):
        return int(s[:-1])
    if s.endswith("m"):
        return int(s[:-1]) * 60
    if s.endswith("h"):
        return int(s[:-1]) * 3600
    return int(s)


_TASK_TERMINAL_OK = {"success", "completed", "succeeded", "done"}
_TASK_TERMINAL_FAIL = {"failed", "error", "errored", "cancelled", "canceled", "timeout"}


def _wait_for_task(task_id: str, *, timeout: str | int | None, insecure: bool, fmt: str) -> int:
    """Poll /api/tasks/{id} until terminal. Returns the exit code to use."""
    import time
    deadline = time.time() + (_parse_timeout(timeout) if isinstance(timeout, str) or timeout is None else int(timeout))
    last_state = None
    while True:
        status, _, resp = api_call(f"/api/tasks/{task_id}", insecure=insecure)
        if status >= 400:
            print(red(f"✗ Task lookup failed: {_extract_error(resp)}"))
            return _exit_for_status(status)
        state = ((resp or {}).get("status") or (resp or {}).get("state") or "").lower() if isinstance(resp, dict) else ""
        if state and state != last_state:
            if fmt != "json":
                print(dim(f"  task {task_id}: {state}"))
            last_state = state
        if state in _TASK_TERMINAL_OK:
            if fmt == "json":
                print(json.dumps(resp, default=str, indent=2))
            else:
                print(green(f"✓ task {task_id}: {state}"))
            return EXIT_OK
        if state in _TASK_TERMINAL_FAIL:
            if fmt == "json":
                print(json.dumps(resp, default=str, indent=2))
            else:
                err = (resp or {}).get("error") or (resp or {}).get("error_message") or ""
                print(red(f"✗ task {task_id}: {state}{(' — ' + err) if err else ''}"))
            return EXIT_ERROR
        if time.time() > deadline:
            print(red(f"✗ task {task_id}: timed out waiting for completion"))
            return EXIT_TIMEOUT
        time.sleep(3)


def cmd_task_status(args) -> None:
    if args.wait:
        sys.exit(_wait_for_task(args.id, timeout=args.timeout, insecure=args.insecure, fmt=args.format))
    status, _, resp = api_call(f"/api/tasks/{args.id}", insecure=args.insecure)
    if status >= 400:
        print(red(f"✗ Task lookup failed: {_extract_error(resp)}"))
        sys.exit(_exit_for_status(status))
    if args.format == "json":
        _emit(args, resp)
        return
    state = ((resp or {}).get("status") or "").lower()
    print(f"task {args.id}: {state or '(unknown)'}")
    if isinstance(resp, dict) and resp.get("error"):
        print(dim(f"  error: {resp['error']}"))


