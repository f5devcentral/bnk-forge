{
  "schema_version": 1,
  "blueprint": {
    "id": "bnk-bare-metal-dpu-infra",
    "version": "1.0.0",
    "name": "DPU Infrastructure (BlueField)",
    "description": "Flashes a BlueField DPU and bootstraps a single-node K8s cluster on a bare-metal host. Deploy BNK Platform separately as Step 2."
  },
  "category": "bare-metal",
  "cloud_provider": null,
  "icon": "cpu",
  "color": "orange",
  "estimated_time": "20-30 minutes",
  "estimated_cost": "N/A (bare-metal)",
  "difficulty": "intermediate",
  "maturity": "beta",
  "bnk_version": null,
  "tags": [
    "bare-metal",
    "dpu",
    "bluefield",
    "k8s",
    "infrastructure"
  ],
  "outcomes": [
    "BlueField DPU flashed with target DOCA/BFB image",
    "Single-node K8s cluster bootstrapped on host",
    "DPU joined as worker node with TMM labels and taints",
    "Cluster auto-registered in BNK Forge for platform deployment"
  ],
  "prerequisites": [
    {
      "type": "bare_metal_host",
      "description": "Registered bare-metal host with SSH access, BlueField DPU, and completed discovery"
    }
  ],
  "variable_templates": {
    "bare_metal_host_id": {
      "label": "Bare-Metal Host",
      "type": "number",
      "required": true,
      "description": "Registered bare-metal host with SSH access and BlueField DPU"
    },
    "cluster_name": {
      "label": "Cluster Name",
      "type": "string",
      "required": true,
      "description": "Name for the K8s cluster (auto-registered in BNK Forge after kubeadm init)"
    },
    "runc_version": {
      "label": "Runc Version",
      "type": "string",
      "default": "1.2.1",
      "required": false,
      "description": "Runc version to install on DPU"
    },
    "containerd_version": {
      "label": "Containerd Version",
      "type": "string",
      "default": "1.7.23",
      "required": false,
      "description": "Containerd version to install on DPU"
    },
    "k8s_version": {
      "label": "Kubernetes Version",
      "type": "string",
      "default": "1.29",
      "required": false,
      "description": "Kubernetes version (major.minor) for kubeadm/kubelet/kubectl"
    },
    "pause_image_tag": {
      "label": "Pause Image Tag",
      "type": "string",
      "default": "3.10",
      "required": false,
      "description": "K8s pause container image tag"
    }
  },
