{
  "schema_version": 1,
  "blueprint": {
    "id": "bnk-bare-metal-full-poc",
    "version": "1.0.0",
    "name": "DPU + BNK Full PoC (All-in-One)",
    "description": "End-to-end: DPU flash \u2192 K8s cluster \u2192 BNK platform in one blueprint. For step-by-step control, use DPU Infrastructure + BNK Platform separately."
  },
  "category": "bare-metal",
  "cloud_provider": null,
  "icon": "cpu",
  "color": "orange",
  "estimated_time": "30-45 minutes",
  "estimated_cost": "N/A (bare-metal)",
  "difficulty": "advanced",
  "maturity": "alpha",
  "bnk_version": "2.2",
  "tags": [
    "bare-metal",
    "dpu",
    "bluefield",
    "bnk",
    "on-prem"
  ],
  "outcomes": [
    "BlueField DPU flashed with target DOCA version",
    "Single-node K8s cluster on bare-metal host",
    "DPU joined as worker node with TMM labels/taints",
    "F5 BNK platform deployed (FLO + CNEInstance + networking)"
  ],
  "prerequisites": [
    {
      "type": "bare_metal_host",
      "description": "Registered bare-metal host with SSH access and BlueField DPU"
    },
    {
      "type": "project_secret",
      "description": "F5 license JWT token from MyF5 (injected into bnk/flo for connected licensing)",
      "name": "jwt_token"
    },
    {
      "type": "project_secret",
      "description": "Base64-encoded F5 FAR service account key JSON content (injected into k8s/bnk-prerequisites). Falls back to encrypted System Default if not set in project.",
      "name": "cne_pull_secret"
    }
  ],
  "variable_templates": {
    "bare_metal_host_id": {
      "label": "Bare-Metal Host",
      "type": "number",
      "required": true,
      "description": "Registered bare-metal host ID"
    },
    "cluster_name": {
      "label": "Cluster Name",
      "type": "string",
      "required": true,
      "description": "Name for the K8s cluster"
    },
    "jwt_token": {
      "label": "F5 License JWT",
      "type": "string",
      "required": false,
      "sensitive": true,
      "description": "F5 license JWT for connected licensing"
    },
    "external_selfip": {
      "label": "TMM External Self-IP (CIDR)",
      "type": "string",
      "required": false,
      "description": "Self-IP for TMM on the external (client-facing) network in CIDR notation (e.g., 10.0.10.240/24)",
      "placeholder": "10.0.10.240/24"
    },
    "internal_selfip": {
      "label": "TMM Internal Self-IP (CIDR)",
      "type": "string",
      "required": false,
      "description": "Self-IP for TMM on the internal (server-facing) network in CIDR notation (e.g., 10.0.20.240/24)",
      "placeholder": "10.0.20.240/24"
    },
    "runc_version": {
      "label": "Runc Version",
      "type": "string",
      "default": "1.2.1",
      "required": false,
      "description": "Runc version to install on DPU"
    },
    "containerd_version": {
      "label": "Containerd Version",
      "type": "string",
      "default": "1.7.23",
      "required": false,
      "description": "Containerd version to install on DPU"
    },
    "k8s_version": {
      "label": "Kubernetes Version",
      "type": "string",
      "default": "1.29",
      "required": false,
      "description": "Kubernetes version (major.minor) for kubeadm/kubelet/kubectl"
    },
    "pause_image_tag": {
      "label": "Pause Image Tag",
      "type": "string",
      "default": "3.10",
      "required": false,
      "description": "K8s pause container image tag"
    }
  },
  "inputs": {
