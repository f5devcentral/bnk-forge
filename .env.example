# BNK-Forge v2 Environment Configuration
# ============================================================================
#
# NOTE: No .env file is needed! All settings are managed via docker-compose.yml
# environment variables and the UI (System > Defaults).
#
# This file documents optional environment variables you can set in
# docker-compose.yml under the backend service's `environment:` section.
#
# ============================================================================

# ============================================================================
# ALLOWED_ORIGINS - Who can access the API (CORS)
# ============================================================================
#
# Default: http://localhost,https://localhost,http://localhost:5173
#
# For production, set to your actual URL(s) in docker-compose.yml. Examples:
#
# Local laptop (default — proxy on 80/443):
#   ALLOWED_ORIGINS=https://localhost
#
# Access from other machines on your network:
#   ALLOWED_ORIGINS=https://localhost,https://192.168.1.100
#
# Production with domain:
#   ALLOWED_ORIGINS=https://bnk-forge.company.com
#
# ALLOWED_ORIGINS=https://localhost

# ============================================================================
# SECURITY KEYS (Auto-generated at startup if not set)
# ============================================================================
#
# For production, generate and set explicitly in docker-compose.yml:
#   JWT_SECRET_KEY=$(openssl rand -hex 32)
#   ENCRYPTION_KEY=$(openssl rand -hex 16)
#
# JWT_SECRET_KEY=your_generated_key_here
# ENCRYPTION_KEY=your_generated_key_here

# ============================================================================
# DATABASE CREDENTIALS (Used by docker-compose.yml)
# ============================================================================
#
# Defaults are safe for local development. For production, set strong passwords
# in docker-compose.yml:
#   POSTGRES_PASSWORD=$(openssl rand -hex 16)
#   REDIS_PASSWORD=$(openssl rand -hex 16)
#
# POSTGRES_PASSWORD=bnkforge_dev_password
# REDIS_PASSWORD=bnkforge_redis_dev

# ============================================================================
# GUI UPGRADE (Required for System > Upgrade Now)
# ============================================================================
#
# Set HOST_REPO_PATH in docker-compose.yml to enable the GUI upgrade button.
# Without this, use SSH + ./upgrade.sh for server upgrades.
#
# HOST_REPO_PATH=/home/jarrodl/bnk-forge-v2

# ============================================================================
# ENVIRONMENT (development/staging/production)
# ============================================================================
#
# Set to 'production' to enforce security key validation at startup.
# Default: development (auto-generates keys without warnings)
#
# ENVIRONMENT=development

# ============================================================================
# MCP SERVICE ACCOUNT (REQUIRED in production; dev defaults shown)
# ============================================================================
#
# MCP authenticates to the backend as a dedicated non-human service account.
# The backend seeds/reconciles this account on every startup so the stored
# password hash always matches MCP_SERVICE_PASSWORD — no auth drift possible.
#
# Change MCP_SERVICE_PASSWORD in production; admin password rotation does NOT
# affect MCP (they are distinct env vars and distinct accounts).
#
# DEFAULT_ADMIN_PASSWORD controls the seeded human admin account (first-boot only,
# must_change_password=True). In production set this to a strong initial value
# that operators change on first login.
#
# MCP_SERVICE_USERNAME=mcp
# MCP_SERVICE_PASSWORD=mcp-service-changeme
# DEFAULT_ADMIN_PASSWORD=changeme

# ============================================================================
# BRANDING (Frontend logo: F5 ball or neutral Forge anvil)
# ============================================================================
#
# Default (unset): neutral anvil/Forge branding — suitable for external use.
# Set BRAND=f5 for internal/UDF deployments to show the F5 ball logo in
# the Sidebar and Login page. No rebuild required — same image digest.
#
# BRAND=f5

# ============================================================================
# F5 BNK CREDENTIALS (Required for BNK deployments)
# ============================================================================
#
# Place your F5 service account JSON key file in the ./secrets/ directory
# and rename it to: far-credentials.json
#
# The file will be mounted into containers at: /app/secrets/far-credentials.json
# See ./secrets/README.md for more details.
