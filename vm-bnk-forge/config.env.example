# bnk-forge VM config — copy to config.env, then edit.
#
#   cp config.env.example config.env
#   $EDITOR config.env
#   ./make-vm.sh
#
# config.env is gitignored; this example is the tracked template.

# --- VM identity & sizing ---
VM_NAME="bnk-forge-1"
VM_MEMORY_MB=16384
VM_VCPUS=8
VM_DISK_GIB=100

# --- Networking (libvirt network name; expected to be a bridge mode net) ---
VM_NETWORK="default"

# --- Repo to clone on first boot ---
REPO_URL="https://github.com/f5devcentral/bnk-forge.git"
# Any git ref `git clone --branch` accepts. A branch tracks moving HEAD (two
# VMs built an hour apart are not the same build); use a release tag such as
# "v1.2.3" when you need a reproducible VM.
BRANCH="staging"

# --- Admin account created inside the VM ---
# Also the only account sshd accepts logins for (AllowUsers). On clouds that
# create their own account (GCP OS Login, Azure admin username), set this to
# match that account or you will be locked out.
ADMIN_USER="ubuntu"

# --- SSH access for the admin user inside the VM ---
# Default (empty): all *.pub files in $HOME/.ssh are authorized.
# Override: point at a single file containing one or more public keys (one per line).
SSH_AUTHORIZED_KEYS_FILE=""

# --- Paths (rarely changed) ---
# Libvirt-managed paths (must be readable by libvirt-qemu).
BASE_IMAGE="/var/lib/libvirt/images/ubuntu-24.04-minimal-base.qcow2"
IMAGES_DIR="/var/lib/libvirt/images"
# DEPLOY_KEY_PRIVATE and TEMPLATES_DIR default to script-relative paths
# (./keys/bnk-forge-deploy and ./templates). Override here if needed:
# DEPLOY_KEY_PRIVATE=""
# TEMPLATES_DIR=""
